# Vite proxies /api,/t,/u,/cron to VITE_API_BASE in dev, so this rarely needs
# to change locally. In a real build (CI/CD), set it to your deployed API origin.
VITE_API_PORT=5173
VITE_API_BASE=http://localhost:3000

# Visual flow builder (dark launch) — baked in at BUILD time. Leave unset/false
# in a production build to keep the /flow route, "New flow" button, and flow
# entry points out of the shipped bundle entirely. Must match the backend's
# FLOW_BUILDER_ENABLED, or the UI won't be able to reach the API even if it's on.
VITE_FLOW_BUILDER_ENABLED=false
