# ---- App ----
PORT=3000
# Long random string. Used to sign login sessions.
SESSION_SECRET=change-this-to-a-long-random-string
# Secret that cron must pass to trigger job processing: /cron/tick?token=...
CRON_TOKEN=change-this-too

# ---- First admin (created automatically on first boot if no users exist) ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=outreach
DB_PASSWORD=
DB_NAME=outreach

# ---- Google Places API (New) ----
GOOGLE_PLACES_API_KEY=

# ---- AI providers (all optional) ----
# A campaign falls back to built-in templates if its chosen provider has no key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Job processing (how many items one cron tick handles) ----
AUDIT_BATCH=5
DRAFT_BATCH=5
SEND_BATCH=10
ENRICH_BATCH=5

# ---- Sending + tracking (Phases 4-5) ----
# Encrypts sending-account credentials at rest. Use a long random string.
APP_SECRET=another-long-random-string-change-me
# Public origin recipients' email clients can reach — REQUIRED for open/click tracking.
# Must be your real https domain in production; localhost pixels never load in inboxes.
PUBLIC_BASE_URL=http://localhost:3000

# ---- Email finding (Phase 3) ----
HUNTER_API_KEY=
# SMTP verification uses outbound port 25, which many hosts block. Off by default.
VERIFY_EMAILS=false
VERIFY_FROM=verify@yourdomain.com

# ---- Visual flow builder (dark launch) ----
# Off unless "true" — a fresh/prod deploy never exposes /api/flows or lets a
# campaign be created with a flow_id until you flip this on. Also set
# VITE_FLOW_BUILDER_ENABLED=true in frontend/.env when you enable this, or the
# API will accept flow campaigns the UI still can't reach.
FLOW_BUILDER_ENABLED=false
